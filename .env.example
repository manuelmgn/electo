# Conexión a Vercel Postgres (en Vercel configúrase automaticamente
# ao crear a base de datos; en local, cópiaa desde o dashboard).
POSTGRES_URL="postgres://user:password@host:5432/dbname"

# Segredo para asinar as sesións. Xera un valor aleatorio, por exemplo:
# openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-un-segredo-longo-e-aleatorio"
